# ── Python / venv ──────────────────────────────────────────────────────────
venv/
__pycache__/
*.pyc
*.pyo
pyvenv.cfg
# Préfixe "/" = seulement à la racine du repo (pas frontend/lib, pas frontend/bin)
/bin/
/include/
/lib/
/lib64/

# ── Nuitka output ──────────────────────────────────────────────────────────
*.build/
*.dist/
dist/

# ── Secrets & config locale ────────────────────────────────────────────────
.env
pos_server.ini
docker-compose.override.yml
certificat/nginx.local.conf

# ── Bases de données locales ───────────────────────────────────────────────
*.sqlite
*.db
*.db-shm
*.db-wal

# ── Contenu uploadé à l'exécution (pas du code source) ─────────────────────
api/static/logos/

# ── Espace de travail local (assets volumineux, jamais versionnés) ─────────
/publication android/
tutorials/_tmp/

# ── Flutter ────────────────────────────────────────────────────────────────
frontend/.dart_tool/
frontend/.flutter-plugins
frontend/.flutter-plugins-dependencies
frontend/build/
frontend/.packages

# ── macOS ──────────────────────────────────────────────────────────────────
.DS_Store

# ── IDE ────────────────────────────────────────────────────────────────────
.vscode/
.idea/

# ── Outils Claude ──────────────────────────────────────────────────────────
.claude/

# ── Certificats SSL — commités (auto-signés pour usage local uniquement)
# server.crt et server.key sont intentionnellement suivis par git :
# ils sont auto-signés pour infini-post.local, pas émis par une CA publique.
# Ne jamais y substituer un certificat signé par une CA réelle.
